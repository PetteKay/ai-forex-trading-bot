# Copy this file to .env and fill in your real keys.
# Load it before starting the bot:
#   Windows PowerShell:  Get-Content .env | ForEach-Object { $name,$value = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($name,$value) }
#   Windows cmd:         for /f "tokens=1,2 delims==" %a in (.env) do set "%a=%b"
#   Linux/macOS:         export $(grep -v '^#' .env | xargs)

# NVIDIA NIM API key — get one free at build.nvidia.com
LLM_API_KEY=your-nvapi-key-here