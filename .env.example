# Copy this file to .env (same folder as config.py / ForexBot.exe) and put in
# your real keys. The bot reads it automatically at start-up.
# Windows environment variables with the same name take priority.

# Your LLM provider's key (the provider is chosen in config.py: LLM_PROVIDER)
# NVIDIA NIM: free key at build.nvidia.com · Ollama (local): any value, e.g. ollama
LLM_API_KEY=your-api-key-here

# Optional: Telegram alerts (config.py: TELEGRAM_ALERTS_ENABLED = True)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: MCP server over HTTP for ChatGPT (MCP.md) — a long random secret
# MCP_HTTP_TOKEN=
